# Supabase — Project Settings → API (or `npx supabase status` when running locally)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Require sign-in (default true). Set to false to open the dashboard without auth.
# Server-only; on Vercel, redeploy after changing it.
AUTH_ENABLED=true

# Fallback public URL for auth email links (the request origin is used when available;
# on Vercel, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL are used automatically)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini — suggests a product name from the first photo (https://aistudio.google.com/apikey).
# Server-only: never prefix with NEXT_PUBLIC_. Leave empty to turn suggestions off.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite). Free-tier limits are per model.
# GEMINI_MODEL=gemini-3.8-flash

# Gemini image editing — powers the manually triggered per-photo "Iron Clothes" action.
# Google currently requires a paid API project for image generation/editing.
# Uses the same server-only GEMINI_API_KEY declared above.
# Optional model override; defaults to the cost-focused Flash Lite image model.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Cloudinary — powers the per-photo "Remove Background" button (e_background_removal; needs the
# Cloudinary AI Background Removal add-on). Server-only: never prefix with NEXT_PUBLIC_.
# Leave empty to turn it off. Cloudinary → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LOCAL ONLY — used by `npm run db:push` / `npm run db:types`. Never add to Vercel, never prefix with NEXT_PUBLIC_.
# Supabase → Connect → Session pooler connection string, with your database password filled in.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
